# Copy to apps/web/.env.local, or run `vercel env pull apps/web/.env.local`.
# Next reads env files from apps/web only.

# Neon Postgres. The Neon integration sets both on Vercel, with a branch of its
# own for each preview deployment.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Local only: a WebSocket proxy (host:port) in front of a plain Postgres, such
# as the one in compose.test.yaml. Leave unset for Neon.
DATABASE_WS_PROXY=

# Auth.js. Make the secret with `npx auth secret`. Production and Preview must
# share one value: production checks the OAuth state that a preview signed.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Production and Preview only: https://nuzlocke.gg/api/auth. Google knows only
# the production and localhost callbacks, so a preview signs in through
# production, which sends the player back to the preview. Production needs it
# too, or it checks PKCE against a cookie on the preview's host. Leave it unset
# locally: with it, local sign-in goes through production.
AUTH_REDIRECT_PROXY_URL=

# Local only: the email of the account that dev sign-in uses, so an agent or a
# script can sign in without Google (see AGENTS.md). The account is made on
# first use. Never works in a production build or on a non-local host.
DEV_AUTH_EMAIL=

# Production only: the secret Vercel Cron sends to /api/cron/* as
# `Authorization: Bearer <secret>`. Make it with `openssl rand -hex 32`.
CRON_SECRET=
