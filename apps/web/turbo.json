{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["$TURBO_EXTENDS$", "public/sprites/**"],
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_UNPOOLED", "DATABASE_WS_PROXY"]
    },
    "dev": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "^build"]
    }
  }
}
