{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "importers", "test", "dist/registry.ts"],
  "exclude": ["node_modules"]
}
